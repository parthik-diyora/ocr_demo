PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
OCR_SERVICE_URL=http://localhost:8000
DATABASE_URL=postgresql://postgres:root@localhost:5432/ocr
USE_IN_MEMORY_DB=false
MAX_UPLOAD_MB=20
LOG_LEVEL=info
JWT_SECRET=ocr-demo-dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# OCR: local (Python service) or google (Document AI)
OCR_PROVIDER_DEFAULT=local
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_DOCUMENTAI_LOCATION=us
GOOGLE_DOCUMENTAI_PROCESSOR_ID=your-processor-id

